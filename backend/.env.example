# Copy to .env and fill in real values. .env is gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# AICredits gateway (OpenAI-compatible base_url + key; model name selects GPT vs Claude)
AICREDITS_BASE_URL=https://your-aicredits-gateway.example.com/v1
AICREDITS_API_KEY=changeme
AICREDITS_TEXT_MODEL=gpt-4o-mini
AICREDITS_VISION_MODEL=gpt-4o-mini
AICREDITS_AGENT_MODEL=gpt-4o-mini

CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
